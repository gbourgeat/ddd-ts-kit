{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["examples/*"],
  "ignoreDependencies": [
    "@arethetypeswrong/cli",
    "publint",
    "eslint-formatter-gitlab",
    "@electric-sql/pglite-socket",
    "@jest/globals",
    "@swc/core",
    "@swc/jest",
    "jest"
  ],
  "workspaces": {
    ".": {
      "entry": ["pipeline/monorepo/*.mjs", "plugin/hooks/*.mjs"],
      "project": ["pipeline/monorepo/**/*.mjs", "plugin/**/*.mjs", "*.{js,cjs,mjs,ts}"],
      "ignoreDependencies": ["@opentelemetry/exporter-prometheus", "@opentelemetry/sdk-metrics"],
      "ignoreBinaries": ["mkfifo"]
    },
    "packages/*": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/prisma": {
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@prisma/client"]
    },
    "site": {
      "ignoreDependencies": ["@fontsource-variable/ibm-plex-sans", "@fontsource/ibm-plex-mono"]
    }
  }
}
