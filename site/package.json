{
  "name": "ddd-ts-kit-site",
  "private": true,
  "type": "module",
  "description": "The documentation website of ddd-ts-kit, assembled from the Markdown pages of the repository. Not published.",
  "scripts": {
    "assemble": "node scripts/assemble.mjs",
    "dev": "node scripts/assemble.mjs && astro dev",
    "build": "node scripts/assemble.mjs && astro build && node scripts/check-built.mjs",
    "preview": "astro preview",
    "social-card": "node scripts/social-card.mjs",
    "test": "node --test scripts/assemble.test.mjs"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.2",
    "mermaid": "12.2.0",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0"
  }
}
