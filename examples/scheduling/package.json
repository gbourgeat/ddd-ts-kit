{
  "name": "scheduling",
  "version": "0.83.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "node scripts/tsc.mjs -p tsconfig.json --noEmit",
    "build": "node scripts/tsc.mjs -p tsconfig.build.json && node scripts/kit.mjs build-aliases",
    "lint": "node scripts/kit.mjs lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ci:typecheck": "npm run typecheck",
    "ci:lint": "node scripts/kit.mjs lint",
    "ci:format": "npm run format:check",
    "ci:arch": "npm run ci:arch:check && npm run ci:arch:graph",
    "ci:arch:check": "node scripts/kit.mjs check",
    "ci:arch:graph": "npm run depcruise",
    "ci:deadcode": "knip",
    "ci:test:unit": "vitest run --project unit --coverage --mode unit",
    "ci:test:integration": "vitest run --project integration --coverage --mode integration",
    "ci:test:e2e": "vitest run --config vitest.e2e.config.ts --passWithNoTests",
    "ci:docs": "npm run docs:check",
    "ci:audit": "npm audit --omit=dev --audit-level=high",
    "ci:build": "npm run build && npm run sdk:build",
    "start": "node dist/src/main.js",
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/platform/tracing.ts --import ddd-ts-kit/dist/refresh-declarations.js src/main.ts",
    "lint:fix": "eslint . --fix",
    "hooks:install": "lefthook install",
    "check:arch": "node scripts/kit.mjs check",
    "depcruise": "node scripts/kit.mjs depcruise-config --check && depcruise src --config .dependency-cruiser.workspace.mjs",
    "deadcode": "knip",
    "quality": "npm run format:check && npm run lint && npm run check:arch && npm run depcruise && npm run deadcode",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:postgres": "vitest run --project integration --no-file-parallelism",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --passWithNoTests",
    "openapi:generate": "npm run build && node dist/scripts/openapi.js",
    "openapi:check": "npm run build && node dist/scripts/openapi.js --check",
    "events:generate": "npm run build && node dist/scripts/events.js",
    "events:check": "npm run build && node dist/scripts/events.js --check",
    "erase:patient": "npm run build && node --env-file-if-exists=.env dist/scripts/erase-patient.js",
    "docs:generate": "node scripts/kit.mjs docs && npm run build && node dist/scripts/openapi.js && node dist/scripts/events.js && node scripts/kit.mjs sdk",
    "docs:check": "node scripts/kit.mjs docs --check && npm run build && node dist/scripts/openapi.js --check && node dist/scripts/events.js --check && node scripts/kit.mjs sdk --check",
    "db:generate": "knex migrate:make",
    "db:migrate": "npm run build && knex migrate:latest",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run test:e2e && npm run check:arch && npm run depcruise && npm run deadcode && npm run docs:check",
    "start:worker": "node dist/src/apps/worker/main.js",
    "sdk:generate": "node scripts/kit.mjs sdk",
    "sdk:build": "node scripts/tsc.mjs -b clients",
    "regenerate": "node scripts/kit.mjs depcruise-config --write && npm run docs:generate"
  },
  "dependencies": {
    "@ddd-ts-kit/aspects": "^0.83.3",
    "@ddd-ts-kit/audit": "^0.83.3",
    "@ddd-ts-kit/auth": "^0.83.3",
    "@ddd-ts-kit/di": "^0.83.3",
    "@ddd-ts-kit/events": "^0.83.3",
    "@ddd-ts-kit/http": "^0.83.3",
    "@ddd-ts-kit/kernel": "^0.83.3",
    "@ddd-ts-kit/knex": "^0.83.3",
    "@ddd-ts-kit/pino": "^0.83.3",
    "@ddd-ts-kit/redis": "^0.83.3",
    "@ddd-ts-kit/scheduling": "^0.83.3",
    "@ddd-ts-kit/sentry": "^0.83.3",
    "@ddd-ts-kit/tracing": "^0.83.3",
    "@ddd-ts-kit/validation": "^0.83.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@sentry/node": "^11.8.0",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-validator-jsonschema": "^5.2.0",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.0.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@ddd-ts-kit/eslint-plugin": "^0.83.3",
    "@ddd-ts-kit/testing": "^0.83.3",
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "ddd-ts-kit": "^0.83.3",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-formatter-gitlab": "^7.2.0",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "clients/*"
  ]
}
