{
  "sourceRoot": "src",
  "contextsDir": "src/contexts",
  "sharedKernelDir": "src/shared-kernel",
  "platformDir": "src/platform",
  "importAlias": "@/",
  "importExtension": "none",
  "stack": {
    "http": "express",
    "validation": "class-validator",
    "di": "tsyringe",
    "events": "outbox",
    "orm": "knex",
    "database": "postgres",
    "tests": "vitest",
    "docsUi": "swagger",
    "ci": "both",
    "authn": "keycloak",
    "authz": "rebac",
    "broker": "redis",
    "cache": "redis",
    "audit": "on",
    "errors": "sentry",
    "logger": "pino",
    "style": "declared",
    "assembly": "barrel",
    "dependencies": "signature",
    "refusals": "factories",
    "routes": "controllers",
    "valueObjects": "throwing"
  },
  "contexts": {
    "identity": {
      "classification": "supporting",
      "upstreams": []
    },
    "scheduling": {
      "classification": "core",
      "upstreams": [
        {
          "context": "identity",
          "relationship": "customer-supplier"
        }
      ]
    },
    "notification": {
      "classification": "supporting",
      "upstreams": [
        {
          "context": "scheduling",
          "relationship": "published-language"
        },
        {
          "context": "identity",
          "relationship": "published-language"
        }
      ]
    },
    "analytics": {
      "classification": "supporting",
      "upstreams": [
        {
          "context": "scheduling",
          "relationship": "conformist"
        }
      ]
    }
  },
  "rules": {},
  "domainAllowedPackages": ["@ddd-ts-kit/kernel"],
  "applicationAllowedPackages": ["@ddd-ts-kit/kernel", "@ddd-ts-kit/auth"],
  "worker": true,
  "deviations": []
}
