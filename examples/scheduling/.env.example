# Copy to .env: `npm run dev` and docker compose both read it. Never commit .env.
NODE_ENV=development
PORT=54300
# debug, info, warn or error.
LOG_LEVEL=info
# json (one line per entry, everywhere) or pretty (a developer's terminal, never in production).
# LOG_FORMAT=pretty
# true writes "[message removed]" for the message of every logged error that is not a DomainError: for logs that leave your hands.
# LOG_SCRUB_MESSAGES=false
# Around every adapter that leaves the process (kinds external and gateway): attempts, first delay, time limit of one attempt.
# OUTBOUND_RETRY_ATTEMPTS=3
# OUTBOUND_RETRY_BASE_DELAY_MS=100
# OUTBOUND_TIMEOUT_MS=2000
# Interactive API documentation at /docs. On by default outside production.
# API_DOCS=true
# Scheduled jobs. RUN_JOBS says whether this process runs them: true by default; `ddd-ts-kit generate worker` moves them to a process of their own.
# One job is switched off in one environment with JOB_<CONTEXT>_<JOB>_ENABLED=false (see src/platform/job-settings.ts).
# RUN_JOBS=true
# The ports below are unusual on purpose: many stacks of a developer machine already hold the default ones.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=54320
DATABASE_URL=postgres://app:app@127.0.0.1:54320/app
OUTBOX_RELAY_INTERVAL_MS=500

# The Redis protocol server (Dragonfly in docker-compose.yml): cache, lock of the scheduled jobs, rate limiter, wake-up of the outbox relay, streams of the integration events.
REDIS_PORT=54379
REDIS_URL=redis://127.0.0.1:54379
# Requests one caller address may send per window before the HTTP layer answers 429.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000

# Varnish in front of the API (docker-compose.yml): the port to read the API through, and where the outbox relay sends the purges.
# Its VCL (docker/varnish/default.vcl) reaches the API on host.docker.internal:54300: change both when PORT changes.
VARNISH_PORT=54081
VARNISH_URL=http://127.0.0.1:54081

# Authentication: the Keycloak realm tokens come from, and the audience this service answers to.
# `docker compose --profile identity up -d --wait` starts a local Keycloak with the realm of docker/keycloak.
# Its demo users (the password of each is its user name: demo-admin, demo-manager, demo-practitioner, demo-assistant, demo-patient,
# demo-patient-2, demo-manager-b, demo-support) and its admin account are for local development ONLY.
KEYCLOAK_PORT=54080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://127.0.0.1:54080
KEYCLOAK_REALM=scheduling
KEYCLOAK_AUDIENCE=scheduling-api
# The client whose client roles join the realm roles of the actor (optional).
# KEYCLOAK_CLIENT_ID=scheduling-api

# Unexpected failures go to a Sentry or a GlitchTip project (same protocol, only the DSN differs). Without SENTRY_DSN the
# application starts and reports nothing. A local GlitchTip: `docker compose --profile errors up -d --wait`, then
# `docker compose logs glitchtip | grep 'DSN:'` prints the DSN; open http://127.0.0.1:54800 (test@example.com / admin_pass, local development ONLY).
# SENTRY_DSN=http://<public-key>@127.0.0.1:54800/1
# The environment issues are filed under (NODE_ENV when left out) and the release they are attached to (none when left out).
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# true removes the message of every reported error that is not a DomainError: for a tracker hosted by a third party.
# SENTRY_SCRUB_MESSAGES=false
GLITCHTIP_PORT=54800

# Traces: start Jaeger with `docker compose --profile observability up -d jaeger`, then open http://127.0.0.1:54686
# Without an endpoint no span leaves the process.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:54318
# Share of the traces kept, 0 to 1, decided where a trace starts; left out, every trace is kept.
# TRACE_SAMPLE_RATIO=1
# continue: a consumed event stays in the trace of the request that published it. link: each delivery starts its own trace, linked to it.
# TRACE_CONSUMERS=continue
OTEL_SERVICE_NAME=scheduling
JAEGER_UI_PORT=54686
OTLP_HTTP_PORT=54318
