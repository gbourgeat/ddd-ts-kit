    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "authorization",
    "authentication",
    "rbac",
    "abac",
    "rebac",
    "zanzibar",
    "access-control"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/auth"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/packages/auth/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "default": "./dist/jwt.js"
    },
    "./passport": {
      "types": "./dist/passport.d.ts",
      "default": "./dist/passport.js"
    },
    "./rebac": {
      "types": "./dist/rebac.d.ts",
      "default": "./dist/rebac.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./di": {
      "types": "./dist/di.d.ts",
      "default": "./dist/di.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/kernel": "0.107.0"
  },
  "peerDependencies": {
    "@ddd-ts-kit/di": "0.107.0",
    "@ddd-ts-kit/testing": "0.107.0",
    "jose": "^6.2.13"
