{
  "name": "@ddd-ts-kit/openfga",
  "version": "0.93.0",
  "description": "The relation tuple store and the authorizer of @ddd-ts-kit/auth on OpenFGA, with the authorization model generated from the relationship schema.",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "openfga",
    "authorization",
    "rebac",
    "zanzibar",
    "fine-grained-authorization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/openfga"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/packages/openfga/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/auth": "0.93.0",
    "@ddd-ts-kit/kernel": "0.93.0"
  },
  "peerDependencies": {
    "@openfga/sdk": "^0.9.7"
  },
  "peerDependenciesMeta": {
    "@openfga/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ddd-ts-kit/testing": "0.93.0",
    "@openfga/sdk": "0.9.7"
  }
}
