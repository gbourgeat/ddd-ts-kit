  },
  "peerDependenciesMeta": {
    "@openfga/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ddd-ts-kit/testing": "0.12.0",
    "@openfga/sdk": "0.9.7"
  }
