      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/auth": "0.12.0",
    "@ddd-ts-kit/kernel": "0.12.0"
