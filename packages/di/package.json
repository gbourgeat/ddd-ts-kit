{
  "name": "@ddd-ts-kit/di",
  "version": "0.108.1",
  "description": "Port classes and context modules on top of tsyringe, InversifyJS or Awilix, for projects without a heavy framework.",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "dependency-injection",
    "tsyringe",
    "inversify",
    "awilix",
    "ioc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/di"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/packages/di/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "default": "./dist/discovery.js"
    },
    "./tsyringe": {
      "types": "./dist/tsyringe.d.ts",
      "default": "./dist/tsyringe.js"
    },
    "./inversify": {
      "types": "./dist/inversify.d.ts",
      "default": "./dist/inversify.js"
    },
    "./awilix": {
      "types": "./dist/awilix.d.ts",
      "default": "./dist/awilix.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/kernel": "0.108.1",
    "@ddd-ts-kit/scheduling": "0.108.1"
  },
  "peerDependencies": {
    "awilix": "^13.0.5",
    "inversify": "^8.2.3",
    "reflect-metadata": ">=0.2.0",
    "tsyringe": "^4.10.0"
  },
  "peerDependenciesMeta": {
    "awilix": {
      "optional": true
    },
    "inversify": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "tsyringe": {
      "optional": true
    }
  },
  "devDependencies": {
    "awilix": "^13.0.5",
    "inversify": "^8.2.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  }
}
