  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "peerDependencies": {
    "@eslint/js": "^9.0.0 || ^10.0.0",
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.71.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/rule-tester": "^8.71.1",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.1"
  }
}
