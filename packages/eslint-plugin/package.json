{
  "name": "@ddd-ts-kit/eslint-plugin",
  "version": "0.4.1",
  "description": "AST-accurate ESLint rules for DDD and Clean Architecture in TypeScript: layer and context isolation, domain purity, clean code ordering.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://github.com/gbourgeat/ddd-ts-kit/tree/main/packages/eslint-plugin#readme",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "ddd",
    "clean-architecture",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "peerDependencies": {
    "@eslint/js": "^9.0.0 || ^10.0.0",
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/utils": "^8.71.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/rule-tester": "^8.71.1",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.1"
  }
}
