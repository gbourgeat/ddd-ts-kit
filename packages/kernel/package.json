{
  "name": "@ddd-ts-kit/kernel",
  "version": "0.86.1",
  "description": "Framework-agnostic Domain-Driven Design (DDD) building blocks for TypeScript: aggregates, entities, value objects, domain events, CQRS command and query buses, unit of work and application ports, with an in-memory event bus.",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "aggregate",
    "value-object",
    "domain-events",
    "cqrs",
    "unit-of-work",
    "ports-and-adapters"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/kernel"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/packages/kernel/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./declarations": {
      "types": "./dist/declarations.d.ts",
      "default": "./dist/declarations.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../pipeline/monorepo/add-extensions.mjs dist"
  }
}
