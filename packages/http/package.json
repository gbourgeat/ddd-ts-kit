{
  "name": "@ddd-ts-kit/http",
  "version": "0.98.0",
  "description": "Framework-agnostic route definitions with Express, Fastify, Hono and NestJS adapters, oRPC and tRPC procedures and OpenAPI 3.1 generation.",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "express",
    "fastify",
    "hono",
    "nestjs",
    "orpc",
    "trpc",
    "openapi",
    "rest-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/http"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/packages/http/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "default": "./dist/nest.js"
    },
    "./orpc": {
      "types": "./dist/orpc.d.ts",
      "default": "./dist/orpc.js"
    },
    "./trpc": {
      "types": "./dist/trpc.d.ts",
      "default": "./dist/trpc.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "default": "./dist/docs.js"
    },
    "./purgers": {
      "types": "./dist/purgers.d.ts",
      "default": "./dist/purgers.js"
    },
    "./uploads": {
      "types": "./dist/uploads.d.ts",
      "default": "./dist/uploads.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/kernel": "0.98.0",
    "@ddd-ts-kit/validation": "0.98.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11.0.0",
    "@nestjs/core": ">=11.0.0",
    "@orpc/server": "^1.15.0",
    "@trpc/server": "^11.10.0",
    "busboy": "^1.6.0",
    "express": "^5.0.0",
    "fastify": "^5.0.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "busboy": {
      "optional": true
    },
    "@orpc/server": {
      "optional": true
    },
    "@trpc/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ddd-ts-kit/testing": "0.98.0",
    "@hono/node-server": "^2.1.4",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@orpc/client": "^1.16.1",
    "@orpc/contract": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.0",
    "busboy": "^1.6.0",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "hono": "^4.13.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.6.5"
  }
}
