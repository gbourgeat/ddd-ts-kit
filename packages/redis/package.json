{
  "name": "@ddd-ts-kit/redis",
  "version": "0.95.0",
  "description": "Adapters of the kernel ports on the Redis protocol (Redis, Dragonfly, Valkey): cache, distributed lock, rate limiter, relay wake-up signal, a background job store, and an integration event provider on Redis Streams.",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "redis",
    "valkey",
    "dragonfly",
    "redis-streams",
    "cache",
    "distributed-lock",
    "rate-limiter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/redis"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/packages/redis/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./event-bus": {
      "types": "./dist/event-bus.d.ts",
      "default": "./dist/event-bus.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/kernel": "0.95.0",
    "@ddd-ts-kit/scheduling": "0.95.0"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0 || ^6.0.0",
    "@ddd-ts-kit/testing": "0.95.0"
  },
  "peerDependenciesMeta": {
    "@ddd-ts-kit/testing": {
      "optional": true
    }
  },
  "devDependencies": {
    "ioredis": "^6.0.0",
    "@ddd-ts-kit/events": "0.95.0",
    "@ddd-ts-kit/testing": "0.95.0",
    "wasmoon-lua5.1": "1.18.12"
  }
}
