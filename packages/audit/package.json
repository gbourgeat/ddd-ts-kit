{
  "name": "@ddd-ts-kit/audit",
  "version": "0.6.0",
  "description": "Tamper-evident audit trail fed from outside the use cases: authorization decisions, executed commands and integration events, as hash-chained append-only entries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/audit"
  },
  "homepage": "https://github.com/gbourgeat/ddd-ts-kit/tree/main/packages/audit#readme",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./knex": {
      "types": "./dist/knex.d.ts",
      "default": "./dist/knex.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/kernel": "0.6.0"
  },
  "peerDependencies": {
    "knex": "^3.0.0",
    "drizzle-orm": ">=0.40.0",
    "@ddd-ts-kit/testing": "0.6.0"
  },
  "peerDependenciesMeta": {
    "knex": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "@ddd-ts-kit/testing": {
      "optional": true
    }
  },
  "devDependencies": {
    "knex": "^3.3.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "@types/pg": "^8.23.1",
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-socket": "0.2.12",
    "@ddd-ts-kit/auth": "0.6.0",
    "@ddd-ts-kit/events": "0.6.0",
    "@ddd-ts-kit/knex": "0.6.0",
    "@ddd-ts-kit/drizzle": "0.6.0",
    "@ddd-ts-kit/testing": "0.6.0"
  }
}
