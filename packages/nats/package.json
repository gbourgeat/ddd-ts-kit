    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "nats",
    "jetstream",
    "integration-events",
    "transactional-outbox",
    "event-driven"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/nats"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/packages/nats/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/events": "0.83.4",
    "@ddd-ts-kit/kernel": "0.83.4"
  },
  "devDependencies": {
