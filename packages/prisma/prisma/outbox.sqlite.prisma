// Models of @ddd-ts-kit/prisma for SQLite. Copy them into your schema.prisma; your own
// `prisma migrate dev` then creates the tables in a migration of your project.
//
// Not covered by the tests of the package: the schema is validated by Prisma, the stores are
// exercised on PostgreSQL only. SQLite has no `FOR UPDATE SKIP LOCKED` (claim with
// `compare-and-set`) and Prisma has no `createMany({ skipDuplicates })` there (see the README
// for the processed-event store).
//
// Keep the field names: the stores of the package are typed against them.

model OutboxRecord {
  /// SQLite only auto-increments an integer primary key, so the roles are swapped here.
  sequence      Int       @id @default(autoincrement())
  id            String    @unique
  type          String
  version       Int
  /// Text, not a timestamp: the envelope must come back exactly as published, offset included.
  occurredAt    String    @map("occurred_at")
  /// Optional because JSON `null` is a legal payload and is stored as SQL NULL.
  payload       Json?
  traceparent   String?
  correlationId String?   @map("correlation_id")
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @map("next_attempt_at")
  lastErrorCode String?   @map("last_error_code")
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status, nextAttemptAt, sequence])
  @@map("outbox")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  /// The unique (consumer, event_id) the store relies on.
  @@id([consumer, eventId])
  @@map("processed_events")
}
