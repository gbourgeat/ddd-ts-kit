// Models of @ddd-ts-kit/prisma for MySQL 8. Copy them into your schema.prisma; your own
// `prisma migrate dev` then creates the tables in a migration of your project.
//
// Not covered by the tests of the package: the schema is validated by Prisma, the stores are
// exercised on PostgreSQL only.
//
// Keep the field names: the stores of the package are typed against them.

model OutboxRecord {
  id            String    @id @db.VarChar(191)
  /// Insertion order, the tie-breaker of the claim. MySQL requires it to be a key.
  sequence      BigInt    @unique @default(autoincrement())
  type          String    @db.Text
  version       Int
  /// Text, not a timestamp: the envelope must come back exactly as published, offset included.
  occurredAt    String    @map("occurred_at") @db.VarChar(64)
  /// Optional because JSON `null` is a legal payload and is stored as SQL NULL.
  payload       Json?
  traceparent   String?   @db.Text
  correlationId String?   @map("correlation_id") @db.Text
  // The tenant of the event, for a multi-tenant project: uncomment it, and give the store `tenant: true`.
  // tenantId      String?   @map("tenant_id") @db.VarChar(191)
  status        String    @default("pending") @db.VarChar(16)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @map("next_attempt_at") @db.DateTime(3)
  lastErrorCode String?   @map("last_error_code") @db.Text
  publishedAt   DateTime? @map("published_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([status, nextAttemptAt, sequence])
  @@map("outbox")
}

model ProcessedEvent {
  consumer    String   @db.VarChar(191)
  eventId     String   @map("event_id") @db.VarChar(191)
  processedAt DateTime @default(now()) @map("processed_at") @db.DateTime(3)

  /// The unique (consumer, event_id) the store relies on.
  @@id([consumer, eventId])
  @@map("processed_events")
}
