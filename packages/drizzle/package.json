{
  "name": "@ddd-ts-kit/drizzle",
  "version": "0.18.0",
  "description": "Drizzle adapters for the kernel ports on PostgreSQL: unit of work, transactional outbox store, processed-event store, event store, background job store, process store, one schema per context.",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "drizzle",
    "drizzle-orm",
    "postgresql",
    "unit-of-work",
    "transactional-outbox",
    "repository-pattern"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/drizzle"
  },
  "homepage": "https://github.com/gbourgeat/ddd-ts-kit/tree/main/packages/drizzle#readme",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/kernel": "0.18.0",
    "@ddd-ts-kit/events": "0.18.0",
    "@ddd-ts-kit/scheduling": "0.18.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.40.0"
  },
  "devDependencies": {
    "drizzle-orm": "latest",
    "@electric-sql/pglite": "0.5.9",
    "@ddd-ts-kit/testing": "0.18.0",
    "pg": "^8.23.1",
    "@types/pg": "^8.23.1"
  }
}
