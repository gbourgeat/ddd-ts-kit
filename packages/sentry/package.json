    "hexagonal-architecture",
    "typescript",
    "sentry",
    "glitchtip",
    "error-reporting",
    "error-tracking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/sentry"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/packages/sentry/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
