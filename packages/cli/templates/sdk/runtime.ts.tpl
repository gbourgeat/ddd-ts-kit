// contract: how a request is written, how its credential is attached, how the answer is read.

/** A credential: the value itself, or a function asked before each request (a token that expires). */
export type Credential = string | (() => string | undefined | Promise<string | undefined>);

export interface ClientOptions<Scheme extends string = string> {
  /** Where the API answers: `https://api.example.com`, or `/api` in a browser on the same origin. */
  readonly baseUrl: string;
  /** The credential of each security scheme of the contract: an operation sends those its security names. */
  readonly credentials?: Partial<Record<Scheme, Credential>>;
  /** Headers sent with every request. */
  readonly headers?: Readonly<Record<string, string>>;
  /** What sends a request: the global `fetch` unless another one is given (a test, a runtime without it, a retry). */
  readonly fetch?: (request: Request) => Promise<Response>;
}

/** What one call may add: headers of its own, a signal that aborts it. */
export interface CallOptions {
  readonly headers?: Readonly<Record<string, string>>;
  readonly signal?: AbortSignal;
}

/** How a security scheme carries its credential. */
export interface SchemeCarrier {
  readonly in: 'header' | 'query' | 'cookie';
  readonly name: string;
  readonly prefix: string;
}

/** The options of a client, with the security schemes of its contract: what every operation is called with. */
export interface Connection {
  readonly baseUrl: string;
  readonly credentials: Readonly<Record<string, Credential | undefined>>;
  readonly headers: Readonly<Record<string, string>>;
  readonly fetch: (request: Request) => Promise<Response>;
  readonly schemes: Readonly<Record<string, SchemeCarrier>>;
}

/** An operation of the contract, as the client sends it and reads its answer. */
export interface Operation {
  readonly method: string;
  readonly path: string;
  /** The alternatives of its security, each the schemes sent together; none, or an empty one: it may be called anonymously. */
  readonly security: readonly (readonly string[])[];
  /** How the body of each status the contract declares is read. */
  readonly responses: Readonly<Record<number, 'json' | 'text' | 'none'>>;
}

type Scalar = string | number | boolean;

/** What a call sends: the parameters and the body the contract declares, and the options of the call. */
export interface CallRequest extends CallOptions {
  readonly path?: Readonly<Record<string, Scalar>>;
  readonly query?: Readonly<Record<string, Scalar | readonly Scalar[] | undefined>>;
  readonly header?: Readonly<Record<string, Scalar | undefined>>;
  readonly body?: unknown;
}

/** A status the contract declares as a success, with its body. */
export interface Success<Status extends number, Data> {
  readonly ok: true;
  readonly status: Status;
  readonly data: Data;
  readonly response: Response;
}

/** A problem document whose `code` is one of the codes the contract declares for its status. */
export type WithCode<Problem, Code extends string> = Problem extends { readonly code: unknown }
  ? Omit<Problem, 'code'> & { readonly code: Code }
  : Problem;

/** A status the contract declares as a refusal, with its problem document. */
export interface Failure<Status extends number, Code extends string, Problem> {
  readonly ok: false;
  readonly status: Status;
  readonly problem: WithCode<Problem, Code>;
  readonly response: Response;
}

/** Any answer an operation declares. */
export type Outcome = Success<number, unknown> | Failure<number, string, unknown>;

/** The body of the successes of an outcome. */
export type DataOf<Result extends Outcome> = Extract<Result, { readonly ok: true }>['data'];

/** The options of a client, made ready to send: the global `fetch` unless another is given. */
export function openConnection(options: ClientOptions, schemes: Readonly<Record<string, SchemeCarrier>>): Connection {
  return {
    baseUrl: withoutTrailingSlashes(options.baseUrl),
    credentials: options.credentials ?? {},
    headers: options.headers ?? {},
    fetch: options.fetch ?? ((request) => fetch(request)),
    schemes,
  };
}

/** A base URL ends where its path starts: `https://api.example.com/v1/` and `.../v1` are one. A loop, not a regular expression, whose time would grow with the square of the slashes. */
function withoutTrailingSlashes(url: string): string {
  let end = url.length;

  while (end > 0 && url.charAt(end - 1) === '/') {
    end -= 1;
  }

  return url.slice(0, end);
}

/**
 * A status the contract does not declare for the operation: a fault of the server (a 500, which
 * the kit answers with a problem document, its `code` `INTERNAL_ERROR` and its `requestId` the
 * reference of the request in the logs of the server), a proxy in between, or a server and a
 * contract that disagree. A problem document answered with it is read: `code` and `requestId`.
 */
