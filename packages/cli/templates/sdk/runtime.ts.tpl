    ? { ok: true, status: response.status, data: body, response }
    : { ok: false, status: response.status, problem: body, response };
}

async function bodyOf(response: Response, read: 'json' | 'text' | 'none'): Promise<unknown> {
  if (read === 'none') {
    return undefined;
  }

  const text = await response.text();

  if (read === 'text') {
    return text;
  }

  return text === '' ? undefined : JSON.parse(text);
}

function codeOf(problem: unknown): string | undefined {
  if (typeof problem !== 'object' || problem === null || !('code' in problem)) {
    return undefined;
  }

  return textOf(problem.code);
}

function textOf(value: unknown): string | undefined {
  return typeof value === 'string' ? value : undefined;
}
