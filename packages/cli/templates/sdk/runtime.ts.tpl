  const init: RequestInit = { method: operation.method, headers };
  const response = await connection.fetch(
    new Request(url, { ...init, ...(body === undefined ? {} : { body }), ...signalOf(request) }),
  );

  return outcomeOf(operation, response);
}

function signalOf(request: CallRequest): { signal?: AbortSignal } {
  return request.signal === undefined ? {} : { signal: request.signal };
}

/** Each set over the one before, whatever the case of its names: a header of the call replaces the one of the client. */
function mergedHeaders(sets: readonly Readonly<Record<string, string>>[]): Headers {
  const headers = new Headers();

  for (const set of sets) {
    for (const [name, value] of Object.entries(set)) {
      headers.set(name, value);
    }
  }

  return headers;
}

function texts(values: CallRequest['header']): Record<string, string> {
  const entries = Object.entries(values ?? {}).flatMap(([name, value]) =>
    value === undefined ? [] : [[name, String(value)] as const],
  );

  return Object.fromEntries(entries);
}

function pathOf(template: string, values: CallRequest['path']): string {
  return template.replace(/\{([^}]+)\}/g, (_match, name: string) => encodeURIComponent(String(values?.[name] ?? '')));
}

/** A list is sent as the parameter repeated, the form OpenAPI calls `explode`. */
function queryOf(values: CallRequest['query']): URLSearchParams {
  const query = new URLSearchParams();

  for (const [name, value] of Object.entries(values ?? {})) {
    for (const one of value === undefined ? [] : Array.isArray(value) ? value : [value]) {
      query.append(name, String(one));
    }
  }

  return query;
}

interface Carried {
  readonly headers: Headers;
  readonly query: URLSearchParams;
}

/** The first alternative of the security whose every scheme has a credential; none: the call goes anonymous, and the API answers as it decides. */
async function authenticate(
  connection: Connection,
  security: Operation['security'],
  carried: Carried,
): Promise<void> {
  for (const alternative of security) {
    const values = await Promise.all(alternative.map((scheme) => resolved(connection.credentials[scheme])));

    if (values.every((value) => value !== undefined)) {
      alternative.forEach((scheme, index) => attach(connection.schemes[scheme], values[index], carried));

      return;
    }
  }
}

async function resolved(credential: Credential | undefined): Promise<string | undefined> {
  return typeof credential === 'function' ? await credential() : credential;
}

function attach(carrier: SchemeCarrier | undefined, value: string | undefined, carried: Carried): void {
  if (carrier === undefined || value === undefined) {
    return;
  }

  if (carrier.in === 'query') {
    carried.query.set(carrier.name, value);
  } else if (carrier.in === 'cookie') {
    // Outside a browser only: a browser drops a Cookie header and sends its own cookies (`credentials: 'include'`).
    const cookie = carried.headers.get('cookie');

    carried.headers.set('cookie', `${cookie === null ? '' : `${cookie}; `}${carrier.name}=${encodeURIComponent(value)}`);
