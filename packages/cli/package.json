{
  "name": "ddd-ts-kit",
  "version": "0.4.0",
  "description": "Bootstrap, scaffold and verify DDD and Clean Architecture TypeScript projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/gbourgeat/ddd-ts-kit/tree/main/packages/cli#readme",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "ddd-ts-kit": "./dist/bin.js",
    "ddd-ts-kit-refresh-declarations": "./dist/refresh-declarations.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean:self": "node dist/bin.js check --clean-only src test",
    "clean:packages": "node dist/bin.js check --clean-only ../kernel/src ../validation/src ../http/src ../tracing/src ../di/src ../events/src ../testing/src ../drizzle/src ../knex/src ../prisma/src ../typeorm/src ../aspects/src ../rabbitmq/src ../auth/src ../audit/src ../redis/src ../scheduling/src ../pino/src ../winston/src ../sentry/src ../kafka/src ../nats/src ../eslint-plugin/src"
  },
  "devDependencies": {
    "@ddd-ts-kit/kernel": "^0.4.0"
  }
}
