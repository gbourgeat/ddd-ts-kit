{
  "name": "ddd-ts-kit",
  "version": "0.26.0",
  "description": "Bootstrap, scaffold and verify Domain-Driven Design (DDD), Clean Architecture and hexagonal TypeScript backends on Node.js: project and code generators, architecture checks, OpenAPI and AsyncAPI documents, for developers and AI coding agents (Claude Code, Codex, GitHub Copilot).",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "cli",
    "scaffolding",
    "code-generator",
    "project-generator",
    "architecture-testing",
    "cqrs",
    "event-sourcing",
    "modular-monolith",
    "microservices",
    "nodejs",
    "claude-code",
    "codex",
    "github-copilot",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "ddd-ts-kit": "./dist/bin.js",
    "ddd-ts-kit-refresh-declarations": "./dist/refresh-declarations.js"
  },
  "files": [
    "dist",
    "templates",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../CHANGELOG.md', 'CHANGELOG.md')\"",
    "clean:self": "node dist/bin.js check --clean-only src test",
    "clean:packages": "node dist/bin.js check --clean-only ../kernel/src ../validation/src ../http/src ../tracing/src ../di/src ../events/src ../testing/src ../s3/src ../drizzle/src ../knex/src ../prisma/src ../typeorm/src ../aspects/src ../rabbitmq/src ../auth/src ../audit/src ../redis/src ../scheduling/src ../pino/src ../winston/src ../sentry/src ../kafka/src ../nats/src ../eslint-plugin/src"
  },
  "devDependencies": {
    "@ddd-ts-kit/kernel": "^0.26.0"
  }
}
