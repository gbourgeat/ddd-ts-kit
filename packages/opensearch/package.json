{
  "name": "@ddd-ts-kit/opensearch",
  "version": "0.106.0",
  "private": true,
  "description": "Adapter of the kernel ReadModelStore port on OpenSearch, with no client library: criteria translated to the query DSL, writes ordered by the event stamp, tenants kept apart by an index each or by filtered aliases on one index.",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "opensearch",
    "elasticsearch",
    "read-model",
    "cqrs",
    "projection",
    "multi-tenant"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/opensearch"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/packages/opensearch/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/kernel": "0.106.0"
  },
  "peerDependencies": {
    "@ddd-ts-kit/testing": "0.106.0"
  },
  "peerDependenciesMeta": {
    "@ddd-ts-kit/testing": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ddd-ts-kit/testing": "0.106.0"
  }
}
