{
  "name": "@ddd-ts-kit/validation",
  "version": "0.22.0",
  "description": "One Schema contract for input validation, with adapters for zod, class-validator, TypeBox and Standard Schema.",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "validation",
    "zod",
    "class-validator",
    "typebox",
    "standard-schema"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/validation"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/packages/validation/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    },
    "./class-validator": {
      "types": "./dist/class-validator.d.ts",
      "default": "./dist/class-validator.js"
    },
    "./standard-schema": {
      "types": "./dist/standard-schema.d.ts",
      "default": "./dist/standard-schema.js"
    },
    "./typebox": {
      "types": "./dist/typebox.d.ts",
      "default": "./dist/typebox.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/kernel": "0.22.0"
  },
  "peerDependencies": {
    "class-transformer": ">=0.5.0",
    "class-validator": ">=0.14.0",
    "class-validator-jsonschema": ">=5.0.0",
    "reflect-metadata": ">=0.2.0",
    "zod": "^4.0.0",
    "typebox": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "class-validator-jsonschema": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-validator-jsonschema": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "typebox": "^1.3.37",
    "valibot": "^1.0.0",
    "zod": "^4.6.5"
  }
}
