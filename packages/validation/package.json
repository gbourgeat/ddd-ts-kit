{
  "name": "@ddd-ts-kit/validation",
  "version": "0.5.0",
  "description": "One Schema contract for input validation, with adapters for zod, class-validator and Standard Schema.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/validation"
  },
  "homepage": "https://github.com/gbourgeat/ddd-ts-kit/tree/main/packages/validation#readme",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    },
    "./class-validator": {
      "types": "./dist/class-validator.d.ts",
      "default": "./dist/class-validator.js"
    },
    "./standard-schema": {
      "types": "./dist/standard-schema.d.ts",
      "default": "./dist/standard-schema.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/kernel": "0.5.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0",
    "class-validator": ">=0.14.0",
    "class-transformer": ">=0.5.0",
    "class-validator-jsonschema": ">=5.0.0",
    "reflect-metadata": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "class-validator-jsonschema": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "zod": "^4.6.5",
    "class-validator": "^0.15.1",
    "class-transformer": "^0.5.1",
    "class-validator-jsonschema": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "valibot": "^1.0.0"
  }
}
