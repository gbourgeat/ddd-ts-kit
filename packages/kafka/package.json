    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "kafka",
    "integration-events",
    "transactional-outbox",
    "event-driven",
    "dead-letter-queue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/kafka"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/packages/kafka/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/events": "0.21.0",
    "@ddd-ts-kit/kernel": "0.21.0"
  },
  "devDependencies": {
    "@confluentinc/kafka-javascript": "^1.11.0",
    "@ddd-ts-kit/testing": "0.21.0"
  },
  "peerDependencies": {
    "@confluentinc/kafka-javascript": ">=1.11.0 <2"
  }
}
