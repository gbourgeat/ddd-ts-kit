{
  "name": "@ddd-ts-kit/testing",
  "version": "0.26.0",
  "description": "Readable tests without mocks: test data builders, given/when/then scenarios and contract suites shared by fakes and real adapters.",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "hexagonal-architecture",
    "typescript",
    "testing",
    "test-data-builder",
    "contract-testing",
    "given-when-then",
    "fakes"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbourgeat/ddd-ts-kit.git",
    "directory": "packages/testing"
  },
  "homepage": "https://gbourgeat.github.io/ddd-ts-kit/packages/testing/",
  "bugs": "https://github.com/gbourgeat/ddd-ts-kit/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./faker": {
      "types": "./dist/faker.d.ts",
      "default": "./dist/faker.js"
    },
    "./e2e": {
      "types": "./dist/e2e.d.ts",
      "default": "./dist/e2e.js"
    },
    "./coverage": {
      "types": "./dist/coverage.d.ts",
      "default": "./dist/coverage.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ddd-ts-kit/kernel": "0.26.0"
  },
  "devDependencies": {
    "@ddd-ts-kit/aspects": "0.26.0",
    "@ddd-ts-kit/events": "0.26.0",
    "@faker-js/faker": "^10.6.0",
    "@ddd-ts-kit/scheduling": "0.26.0"
  },
  "peerDependencies": {
    "@faker-js/faker": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    }
  }
}
